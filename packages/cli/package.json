{
  "name": "@notifie-dev/cli",
  "version": "0.1.0-beta.1",
  "description": "Notifie project setup, local diagnostics, demos, and Cloud connection tooling.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit1521/notifie.git",
    "directory": "packages/cli"
  },
  "homepage": "https://notifie.dev",
  "bugs": "https://github.com/rohit1521/notifie/issues",
  "type": "module",
  "bin": {
    "notifie": "./dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --pack-destination .pack"
  },
  "dependencies": {
    "@notifie-dev/contracts": "workspace:*",
    "fast-xml-parser": "5.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
