{
  "name": "@notifie-dev/server",
  "version": "0.1.0-beta.1",
  "description": "Notifie Cloud HTTP client for trusted server environments.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit1521/notifie.git",
    "directory": "packages/server"
  },
  "homepage": "https://notifie.dev",
  "bugs": "https://github.com/rohit1521/notifie/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --pack-destination .pack"
  },
  "dependencies": {
    "@notifie-dev/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}