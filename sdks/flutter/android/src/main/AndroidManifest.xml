<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <permission
        android:name="${applicationId}.permission.NOTIFIE_NOTIFICATION_OPEN"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.NOTIFIE_NOTIFICATION_OPEN" />

    <application>
        <!--
          This plugin depends on the Android SDK, whose manifest declares its own
          activity for the same intent action. Both survive the merge, so Android
          cannot choose between them and asks the user to "Complete action using"
          one of two identical copies of their own app on every notification tap.
          Worse, the native activity navigates the deep link itself, which throws
          ActivityNotFoundException in a Flutter app that resolves routes in Dart.

          Removing it leaves exactly one handler: the activity below, which only
          ever launches this app and hands the payload to Dart.
        -->
        <activity
            android:name="dev.notifie.NotifieNotificationOpenActivity"
            tools:node="remove" />

        <activity
            android:name=".NotifieNotificationOpenActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="${applicationId}.permission.NOTIFIE_NOTIFICATION_OPEN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="dev.notifie.NOTIFICATION_OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
